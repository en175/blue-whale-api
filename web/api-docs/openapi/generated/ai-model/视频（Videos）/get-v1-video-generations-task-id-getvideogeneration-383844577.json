{
  "openapi": "3.1.0",
  "info": {
    "title": "获取视频生成任务状态",
    "version": "1.0.0",
    "description": "查询视频生成任务的实时状态和结果。\n\n任务状态：\n- `SUBMITTED` / `QUEUED`: 排队中\n- `IN_PROGRESS`: 处理中\n- `SUCCESS`: 已完成\n- `FAILURE`: 失败\n- `UNKNOWN`: 未知"
  },
  "tags": [
    {
      "name": "视频（Videos）"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 Bearer Token 认证。\n格式: `Authorization: Bearer sk-xxxxxx`\n"
      }
    }
  },
  "paths": {
    "/v1/video/generations/{task_id}": {
      "get": {
        "tags": [
          "视频（Videos）"
        ],
        "summary": "获取视频生成任务状态",
        "description": "查询视频生成任务的实时状态和结果。\n\n任务状态：\n- `SUBMITTED` / `QUEUED`: 排队中\n- `IN_PROGRESS`: 处理中\n- `SUCCESS`: 已完成\n- `FAILURE`: 失败\n- `UNKNOWN`: 未知",
        "operationId": "getvideogeneration",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "任务 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "查询任务状态响应",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "状态码",
                      "examples": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "description": "消息"
                    },
                    "data": {
                      "type": "object",
                      "description": "任务详情",
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID",
                          "examples": [
                            "task_9f3a2b7c"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "description": "任务状态：SUBMITTED/QUEUED/IN_PROGRESS/SUCCESS/FAILURE/UNKNOWN",
                          "examples": [
                            "SUCCESS"
                          ]
                        },
                        "fail_reason": {
                          "type": "string",
                          "description": "失败原因"
                        },
                        "result_url": {
                          "type": "string",
                          "description": "结果视频 URL"
                        },
                        "submit_time": {
                          "type": "integer",
                          "description": "提交时间（Unix 秒）"
                        },
                        "start_time": {
                          "type": "integer",
                          "description": "开始时间（Unix 秒）"
                        },
                        "finish_time": {
                          "type": "integer",
                          "description": "完成时间（Unix 秒）"
                        },
                        "progress": {
                          "type": "string",
                          "description": "进度",
                          "examples": [
                            "100%"
                          ]
                        }
                      },
                      "x-apifox-orders": [
                        "task_id",
                        "status",
                        "fail_reason",
                        "result_url",
                        "submit_time",
                        "start_time",
                        "finish_time",
                        "progress"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "错误码"
                    },
                    "message": {
                      "type": "string",
                      "description": "错误描述"
                    },
                    "data": {
                      "type": "null",
                      "description": "附加数据，通常为 null"
                    }
                  },
                  "x-apifox-orders": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}